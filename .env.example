# Copy to .env for local runs (export them or use: set -a; source .env; set +a)
# In production these live in GitHub repo secrets.

# Supabase — use the SECRET key (sb_secret_...), not the publishable one
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Outlook / Microsoft Graph — from Entra app registration + scripts/outlook_auth.py
MS_CLIENT_ID=
MS_TENANT_ID=
MS_REFRESH_TOKEN=

# Gmail (dormant poller, only for Gmail users)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Slack — User OAuth token from the app created via slack-app-manifest.yml
SLACK_USER_TOKEN=xoxp-...
